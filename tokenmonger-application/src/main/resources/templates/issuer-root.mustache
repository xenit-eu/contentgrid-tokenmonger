<!DOCTYPE html>
<html lang="en">
<head>
    <title>Configuration for issuer {{ serverMetadata.issuer }}</title>
</head>
<body>
<h1>Configuration for issuer "{{ serverMetadata.issuer }}"</h1>
<p>{{ description }}</p>
<dl>
    <dt>Issuer</dt>
    <dd><code>{{ serverMetadata.issuer }}</code></dd>
    <dt>OAuth server metadata configuration</dt>
    <dd>
        <a href="{{ serverConfiguration.oAuthServerMetadataUri }}">
            <code>{{ serverConfiguration.oAuthServerMetadataUri }}</code>
        </a>
    </dd>
    {{#serverMetadata.tokenEndpoint}}
        <dt>Token endpoint</dt>
        <dd><code>{{ . }}</code></dd>
    {{/serverMetadata.tokenEndpoint}}
    <dt>JWKSet URI</dt>
    <dd><code>{{ serverMetadata.jwksUri }}</code></dd>
</dl>
<h1>Token endpoint requirements</h1>
<ul>
    {{#validators}}
        <li>{{ description }}</li>
    {{/validators}}
</ul>
</body>
</html>